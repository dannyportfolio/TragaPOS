# ==============================================================================
# Environment Configuration Template for Ticket-Prod
# Copy to .env or run: bash scripts/generate-keys.sh
# ==============================================================================

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pos_central
POSTGRES_PORT=5432

# Shared Security & Cryptography (Generate via: bash scripts/generate-keys.sh)
APP_ENV=development
ED25519_PRIVATE_KEY=
ED25519_PUBLIC_KEY=
EDGE_AUTH_TOKEN=change-me-edge-sync-token
API_AUTH_TOKEN=
ALLOWED_ORIGINS=

# Cloud Service Settings
CLOUD_PORT=8080
DATABASE_URL=postgres://postgres:postgres@pos-postgres:5432/pos_central?sslmode=disable
SYNC_BATCH_SIZE=100

# Edge Service Settings
EDGE_PORT=8081
TENANT_ID=tenant-park-01
OUTLET_ID=outlet-gate-north
CLOUD_SYNC_URL=http://pos-cloud:8080
SQLITE_PATH=/data/edge.db
SYNC_INTERVAL_SEC=5

# Web UI Settings
WEB_PORT=3000
